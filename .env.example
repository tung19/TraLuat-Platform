# Generate a private key, for example: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=traluat
JWT_AUDIENCE=traluat-api

# Required by compose API/worker: a non-owner, non-superuser login granted traluat_app.
# Container hostname/port is postgres:5432; host development uses localhost:5433.
APP_DATABASE_URL=

# Explicit local AI wiring. Existing Ollama model on this development machine.
# Use disabled to keep only non-generative endpoints; demo is explicit Echo testing.
TRALUAT_AI_MODE=local
TRALUAT_LOCAL_BACKEND=ollama
TRALUAT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRALUAT_LOCAL_MODEL=qwen2.5-coder:latest
TRALUAT_LOCAL_TIMEOUT=90
TRALUAT_MODELS_OFFLINE=1
TRALUAT_EMBED_MODEL=BAAI/bge-m3
TRALUAT_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# Optional: TRALUAT_MODEL_DEVICE=cpu (otherwise auto MPS/CPU)
# Optional immutable model revisions: TRALUAT_EMBED_REVISION, TRALUAT_NLI_REVISION

# Optional, separate privileged connector, only used for verified platform operators.
# Leave unset until KB administration is explicitly provisioned.
# KNOWLEDGE_DATABASE_URL=
